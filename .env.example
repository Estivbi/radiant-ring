# --- Formulario de contacto (Vercel > Settings > Environment Variables) ---
# Obligatorio en producción: cadena aleatoria larga (openssl rand -hex 32)
FORM_SECRET=
# Resend (https://resend.com): clave y destino de los mensajes
RESEND_API_KEY=
CONTACT_TO=
# Remitente verificado en Resend (opcional; por defecto onboarding@resend.dev)
CONTACT_FROM=
# Cloudflare Turnstile (gratis): https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Rate limit global (recomendado): Upstash Redis desde el Marketplace de Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
