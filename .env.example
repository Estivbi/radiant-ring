# --- Formulario de contacto (Vercel > Settings > Environment Variables) ---
# Obligatorio en producción: cadena aleatoria larga (openssl rand -hex 32)
FORM_SECRET=
# Dónde llegan los mensajes (buzón de Custodio). Al pulsar "Responder" contesta directo a quien escribió.
CONTACT_TO=

# Correo saliente por SMTP, sin servicios de terceros. Ejemplo con Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=cuenta@gmail.com
#   SMTP_PASS = "contraseña de aplicación" (Cuenta Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente (opcional; por defecto SMTP_USER)
MAIL_FROM=
# Alternativa a SMTP: Resend (solo si no hay SMTP_*)
RESEND_API_KEY=

# Cloudflare Turnstile (gratis): https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limit global y métricas: Upstash Redis desde el Marketplace de Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Panel /estadisticas?key=...  (openssl rand -hex 16)
STATS_KEY=
# Informe mensual por email: Vercel Cron lo llama el día 1. CRON_SECRET = cadena aleatoria (Vercel la envía sola).
CRON_SECRET=
# Destinatario del informe (por defecto CONTACT_TO)
REPORT_TO=

# Google Search Console: contenido de la metaetiqueta de verificación (opcional si verificas por DNS)
PUBLIC_GSC_VERIFICATION=
