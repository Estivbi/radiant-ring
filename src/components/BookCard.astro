---
import type { Book } from '../data/books';
import BuyButtons from './BuyButtons.astro';
interface Props { book: Book; number?: number; }
const { book, number } = Astro.props;
---
<article class="reveal group flex h-full flex-col rounded-2xl border border-bone/10 bg-ink-900 p-5 transition hover:border-bone/25">
  <a href={`/books/${book.id}`} class="relative block overflow-hidden rounded-lg bg-ink-800" aria-label={`Ver ${book.title}`}>
    <div class="aspect-[2/3]">
      <img src={book.cover} alt={`Portada de ${book.title}`} loading="lazy" decoding="async" width="400" height="600"
        class:list={['h-full w-full transition duration-700 group-hover:scale-[1.04]', book.coverFit === 'contain' ? 'object-contain' : 'object-cover']} />
    </div>
    {number && <span class="absolute left-3 top-3 grid h-9 w-9 place-items-center rounded-full bg-blood font-display text-xl font-bold text-white">{number}</span>}
  </a>
  <div class="mt-5 flex flex-1 flex-col">
    {book.subtitle && <p class="eyebrow">{book.subtitle}</p>}
    <h3 class="mt-1 text-2xl leading-tight"><a href={`/books/${book.id}`} class="hover:text-brass">{book.title}</a></h3>
    <p class="mt-2 flex-1 text-sm text-bone-dim">{book.tagline}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      <BuyButtons book={book} size="sm" />
      <a href={`/books/${book.id}`} class="btn btn-ghost !px-4 !py-2">Leer más</a>
    </div>
  </div>
</article>
