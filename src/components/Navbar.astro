---
const links = [
  { href: '/#saga', label: 'La saga' },
  { href: '/#libros', label: 'Libros' },
  { href: '/#autor', label: 'El autor' },
  { href: '/#prensa', label: 'En los medios' },
];
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="/" class="font-display text-2xl font-bold tracking-wide text-bone">Custodio <span class="text-blood-bright">J. Pérez</span></a>

    <nav aria-label="Principal" class="hidden items-center gap-8 md:flex">
      {links.map((l) => <a href={l.href} class="text-sm text-bone-dim transition hover:text-bone">{l.label}</a>)}
      <a href="/#contacto" class="btn btn-primary !py-2">Contacto</a>
      <button type="button" class="theme-toggle grid h-11 w-11 place-items-center rounded-full border border-bone/20 text-bone-dim transition hover:border-bone/50 hover:text-bone" aria-label="Cambiar a modo claro" title="Cambiar tema">
        <svg class="icon-sun hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <button type="button" class="theme-toggle grid h-11 w-11 place-items-center rounded-full border border-bone/20 text-bone-dim" aria-label="Cambiar a modo claro" title="Cambiar tema">
        <svg class="icon-sun hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button id="menu-btn" class="grid h-11 w-11 place-items-center rounded-full border border-bone/20" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div id="menu" hidden class="border-t border-bone/10 bg-ink-950/95 backdrop-blur md:hidden">
    <nav aria-label="Móvil" class="mx-auto flex max-w-6xl flex-col px-5 py-4">
      {links.map((l) => <a href={l.href} class="menu-link border-b border-bone/10 py-4 font-display text-2xl">{l.label}</a>)}
      <a href="/#contacto" class="menu-link py-4 font-display text-2xl text-blood-bright">Contacto</a>
    </nav>
  </div>
</header>
<script>
  // Tema: oscuro/claro según el sistema por defecto; el botón alterna y recuerda la elección.
  const root = document.documentElement;
  const apply = (t: string) => {
    root.dataset.theme = t;
    document.querySelectorAll<HTMLElement>('.theme-toggle').forEach((b) => {
      b.setAttribute('aria-label', t === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
      b.querySelector('.icon-sun')!.classList.toggle('hidden', t !== 'dark');
      b.querySelector('.icon-moon')!.classList.toggle('hidden', t === 'dark');
    });
  };
  apply(root.dataset.theme || 'dark');
  document.querySelectorAll('.theme-toggle').forEach((b) =>
    b.addEventListener('click', () => {
      const t = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(t);
      try { localStorage.setItem('theme', t); } catch {}
    })
  );
  // Si el usuario no eligió manualmente, seguir los cambios del sistema.
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
    let saved: string | null = null;
    try { saved = localStorage.getItem('theme'); } catch {}
    if (!saved) apply(e.matches ? 'light' : 'dark');
  });

  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('menu')!;
  const set = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    header.classList.toggle('bg-ink-950/95', open);
  };
  btn.addEventListener('click', () => set(menu.hidden));
  menu.querySelectorAll('.menu-link').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
  const onScroll = () => {
    const s = window.scrollY > 40;
    header.classList.toggle('bg-ink-950/80', s);
    header.classList.toggle('backdrop-blur', s);
    header.classList.toggle('border-b', s);
    header.classList.toggle('border-bone/10', s);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
