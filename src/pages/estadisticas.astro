---
import { timingSafeEqual, createHash } from 'node:crypto';
import Layout from '../layouts/Layout.astro';
import { readDays, metricsEnabled } from '../lib/metrics';
import { rateLimit, clientIp, env } from '../lib/security';
import { books } from '../data/books';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noai');

// Acceso por clave (STATS_KEY). Comparación en tiempo constante + límite de intentos.
const sha = (s: string) => createHash('sha256').update(s).digest();
const secret = env('STATS_KEY');
const given = Astro.url.searchParams.get('key') ?? '';
let authorized = false, blocked = false;
if (secret && given) {
  const rl = await rateLimit(`st:${clientIp(Astro.request)}`, 10, 600);
  blocked = !rl.ok;
  authorized = !blocked && timingSafeEqual(sha(given), sha(secret));
}

let days: Awaited<ReturnType<typeof readDays>> = [];
if (authorized && metricsEnabled()) days = await readDays(30);

const sum = (ev: string, from = 0) => days.slice(from).reduce((a, d) => a + (d.data[ev] ?? 0), 0);
const last7 = Math.max(0, days.length - 7);
const perBook = books
  .map((b) => ({ id: b.id, title: b.short, amazon: sum(`amazon_click:${b.id}`), direct: sum(`direct_buy_click:${b.id}`) }))
  .sort((a, b) => b.amazon - a.amazon);
const maxBook = Math.max(1, ...perBook.map((b) => b.amazon));
const visits = sum('visit'), amazon = sum('amazon_click');
const rate = visits ? ((amazon / visits) * 100).toFixed(1).replace('.', ',') : '0';
const maxDay = Math.max(1, ...days.map((d) => d.data.visit ?? 0));
const cards = [
  { label: 'Visitas (sesiones)', v: visits, sub: `${sum('visit', last7)} en los últimos 7 días` },
  { label: 'Clics hacia Amazon', v: amazon, sub: `${sum('amazon_click', last7)} en los últimos 7 días` },
  { label: 'Clics a Amazon por cada 100 visitas', v: rate, sub: 'visitantes que pasan a comprar' },
  { label: 'Mensajes enviados', v: sum('contact_sent'), sub: 'por el formulario' },
  { label: 'Pedidos de ejemplar firmado', v: sum('direct_buy_click'), sub: 'clics en «Pedírselo a Custodio»' },
  { label: 'Clics a Instagram', v: sum('instagram_click'), sub: '' },
  { label: 'Clics a las entrevistas de RTVE', v: sum('press_click'), sub: '' },
];
---
<Layout title="Estadísticas" description="Panel privado" noindex>
  <div class="mx-auto max-w-5xl px-5 pb-24 pt-32">
    <h1 class="text-5xl">Estadísticas de la web</h1>
    {!authorized ? (
      <p class="mt-6 text-bone-dim">{blocked ? 'Demasiados intentos. Espera unos minutos.' : 'Acceso privado. Añade tu clave a la dirección: /estadisticas?key=TU_CLAVE'}</p>
    ) : !metricsEnabled() ? (
      <p class="mt-6 rounded-lg border border-blood/60 p-4">Faltan las variables UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN: aún no se están guardando métricas.</p>
    ) : (
      <>
        <p class="mt-3 text-bone-dim">Últimos 30 días. Los datos son anónimos: no se guardan cookies, direcciones IP ni identidades.</p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {cards.map((c) => (
            <div class="rounded-2xl border border-bone/10 bg-ink-900 p-5">
              <p class="text-sm text-bone-mute">{c.label}</p>
              <p class="mt-1 font-display text-5xl text-brass lining-nums">{c.v}</p>
              {c.sub && <p class="mt-1 text-xs text-bone-mute">{c.sub}</p>}
            </div>
          ))}
        </div>

        <h2 class="mt-14 text-3xl">Visitas por día</h2>
        <div class="mt-4 flex h-40 items-end gap-1 rounded-2xl border border-bone/10 bg-ink-900 p-4" role="img" aria-label="Gráfico de visitas diarias de los últimos 30 días">
          {days.map((d) => <div class="flex-1 rounded-t bg-blood" style={`height:${Math.max(2, ((d.data.visit ?? 0) / maxDay) * 100)}%`} title={`${d.date}: ${d.data.visit ?? 0}`}></div>)}
        </div>
        <p class="mt-2 text-xs text-bone-mute">Del {days[0]?.date} al {days[days.length - 1]?.date}</p>

        <h2 class="mt-14 text-3xl">Clics a Amazon por libro</h2>
        <ul class="mt-4 space-y-3">
          {perBook.map((b) => (
            <li class="rounded-xl border border-bone/10 bg-ink-900 p-4">
              <div class="flex justify-between gap-4"><span>{b.title}</span><span class="font-display text-2xl text-brass lining-nums">{b.amazon}</span></div>
              <div class="mt-2 h-2 rounded bg-ink-700"><div class="h-2 rounded bg-blood" style={`width:${(b.amazon / maxBook) * 100}%`}></div></div>
              {b.direct > 0 && <p class="mt-2 text-xs text-bone-mute">{b.direct} pedidos de ejemplar firmado</p>}
            </li>
          ))}
        </ul>

        <aside class="mt-14 rounded-2xl border border-brass/30 p-5 text-sm text-bone-dim">
          <p class="font-semibold text-bone">Cómo leer estos números</p>
          <p class="mt-2">Un «clic a Amazon» es alguien que ha decidido ir a comprar; la compra final ocurre dentro de Amazon y la web no la puede ver. Para saber las ventas reales, compara estos clics con las ventas de tu panel de KDP en las mismas fechas.</p>
        </aside>
      </>
    )}
  </div>
</Layout>
